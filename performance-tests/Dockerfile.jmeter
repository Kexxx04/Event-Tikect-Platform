# Apache JMeter with a fixed version, checked against the SHA-512 that Apache publishes
# (https://archive.apache.org/dist/jmeter/binaries/apache-jmeter-5.6.3.tgz.sha512). The Apache CDN is fast but
# only keeps the latest release; the archive keeps every version, but it is slow.
FROM eclipse-temurin:21-jre-alpine
ARG JMETER_VERSION=5.6.3
ARG JMETER_SHA512=5978a1a35edb5a7d428e270564ff49d2b1b257a65e17a759d259a9283fc17093e522fe46f474a043864aea6910683486340706d745fcdf3db1505fd71e689083
RUN apk add --no-cache tzdata \
    && { wget -q -O /tmp/jmeter.tgz \
            "https://dlcdn.apache.org/jmeter/binaries/apache-jmeter-${JMETER_VERSION}.tgz" \
        || wget -q -O /tmp/jmeter.tgz \
            "https://archive.apache.org/dist/jmeter/binaries/apache-jmeter-${JMETER_VERSION}.tgz"; } \
    && echo "${JMETER_SHA512}  /tmp/jmeter.tgz" | sha512sum -c - \
    && tar -xzf /tmp/jmeter.tgz -C /opt \
    && rm /tmp/jmeter.tgz \
    && addgroup -S jmeter && adduser -S jmeter -G jmeter
ENV JMETER_HOME=/opt/apache-jmeter-${JMETER_VERSION} \
    PATH=/opt/apache-jmeter-${JMETER_VERSION}/bin:$PATH \
    TZ=America/Bogota \
    HEAP="-Xms512m -Xmx1g -XX:MaxMetaspaceSize=256m"
USER jmeter
WORKDIR /results
ENTRYPOINT ["jmeter"]
