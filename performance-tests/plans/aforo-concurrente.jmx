                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">String id = UUID.randomUUID().toString()
vars.put('userEmail', 'stress-' + id + '@example.com')
vars.put('userDocument', 'STRESS-' + id)</stringProp>
