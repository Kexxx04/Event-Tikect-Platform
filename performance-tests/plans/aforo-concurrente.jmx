          </collectionProp>
        </HeaderManager>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/events/{id}/availability (tearDown)">
          <stringProp name="HTTPSampler.path">/api/events/${__P(eventId)}/availability</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 200">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="registeredCount == capacity (100)">
            <stringProp name="JSON_PATH">$.registeredCount</stringProp>
            <stringProp name="EXPECTED_VALUE">${__P(capacity,100)}</stringProp>
            <boolProp name="JSONVALIDATION">true</boolProp>
            <boolProp name="EXPECT_NULL">false</boolProp>
            <boolProp name="INVERT">false</boolProp>
            <boolProp name="ISREGEX">false</boolProp>
          </JSONPathAssertion>
          <hashTree/>
          <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="waitlistCount == users - capacity (900)">
            <stringProp name="JSON_PATH">$.waitlistCount</stringProp>
            <stringProp name="EXPECTED_VALUE">${__intSum(${__P(users,1000)},-${__P(capacity,100)})}</stringProp>
            <boolProp name="JSONVALIDATION">true</boolProp>
            <boolProp name="EXPECT_NULL">false</boolProp>
            <boolProp name="INVERT">false</boolProp>
            <boolProp name="ISREGEX">false</boolProp>
          </JSONPathAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Sin sobrecupo: registeredCount &lt;= capacity">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

def availability = new JsonSlurper().parseText(prev.getResponseDataAsString())
if (availability.registeredCount &gt; availability.capacity) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Overbooking: registeredCount ' + availability.registeredCount
            + ' is greater than capacity ' + availability.capacity)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Guardar aforo-resultado.json">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonOutput
import groovy.json.JsonSlurper

// Read by run-perf.ps1 for resumen.md: what the API reports and what the 1000 clients received.
def responses = [:]
props.get('statusCounts').each { status, count -&gt; responses[status] = count.get() }
def result = [
        users                : props.getProperty('users', '1000') as int,
        capacity             : props.getProperty('capacity', '100') as int,
        availability         : new JsonSlurper().parseText(prev.getResponseDataAsString()),
        registrationResponses: responses
]
new File(props.getProperty('resultsDir', '.'), 'aforo-resultado.json').text =
        JsonOutput.prettyPrint(JsonOutput.toJson(result))</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
