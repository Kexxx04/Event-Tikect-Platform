# Complete stack: compose.yaml (API + PostgreSQL).
# Copy to .env and set your local password before the first startup.
POSTGRES_DB=event_platform
POSTGRES_USER=event_team
POSTGRES_PASSWORD=replace_with_your_team_password
API_PORT=8080
# Administrator login for the API and frontend.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_an_admin_password
# HS256 signing key for JWTs: at least 32 random characters.
JWT_SECRET=replace_with_at_least_32_random_characters
