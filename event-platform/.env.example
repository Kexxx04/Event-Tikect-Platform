# Development template for compose.dev.yaml and a locally running API.
# For the complete Docker stack (compose.yaml), use .env.docker.example instead.
# Copy to .env: Docker Compose and the API (bootRun/IntelliJ) both read it automatically.
POSTGRES_DB=event_platform
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=replace_with_your_database_password
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/event_platform
DB_USERNAME=your_database_user
DB_PASSWORD=replace_with_your_database_password
SONAR_TOKEN=replace_with_a_new_sonar_token
SONAR_HOST_URL=http://localhost:9000

# Administrator login for the API and frontend.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_an_admin_password
# HS256 signing key for JWTs: at least 32 random characters.
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRATION=PT8H
